# Copy to .env. Never commit .env.
APP_ENV=development
APP_NAME=AVaaS Enterprise
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./avaas.db
JWT_SECRET=GENERATE_A_RANDOM_64_BYTE_SECRET
FIELD_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
ALLOW_PUBLIC_REGISTRATION=true
CORS_ORIGINS=http://localhost:5173

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_ATTEMPTS=1

BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ALLOW_PRIVATE_TARGETS=false
MAX_CONCURRENCY=4
MAX_TEST_CASES=20

USE_DEEPEVAL=true
COMPOSITE_RULE_WEIGHT=0.40
COMPOSITE_SAFETY_WEIGHT=0.30
COMPOSITE_BUSINESS_WEIGHT=0.30
COMPOSITE_QUALITY_WEIGHT=0.0
PASS_SCORE_THRESHOLD=70
REGRESSION_SCORE_DROP_THRESHOLD=10
REGRESSION_PASS_RATE_DROP_THRESHOLD=0.10

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=avaas
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=avaas

# Async runner resilience (Phase 2)
REQUEST_MAX_RETRIES=2
REQUEST_BACKOFF_SECONDS=0.5
REQUEST_RATE_LIMIT_PER_SEC=0.0
# Set false when Alembic owns the schema (production); true auto-creates tables in dev
AUTO_CREATE_TABLES=true
