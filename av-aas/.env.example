# ------------------------------------------------------------------
# AVaaS environment configuration
# Copy this file to .env and fill in the values you need.
# Every variable has a safe default except where noted MANDATORY.
# ------------------------------------------------------------------

# --- App ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database (SQLite by default, no setup required) ---
DATABASE_URL=sqlite:///./avaas.db

# --- LLM provider ---
# One of: mock | ollama | gemini
# mock    -> no external service required, deterministic heuristic scoring.
#            Use this to run the whole system with zero API keys/services.
# ollama  -> requires a local Ollama server (https://ollama.com) running
#            and OLLAMA_BASE_URL/OLLAMA_MODEL below.
# gemini  -> requires GEMINI_API_KEY below (MANDATORY if you pick gemini).
LLM_PROVIDER=mock

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# MANDATORY only if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Execution ---
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENCY=8

# --- Evaluation / scoring ---
PASS_SCORE_THRESHOLD=70
COMPOSITE_RULE_WEIGHT=0.6
COMPOSITE_LLM_WEIGHT=0.4
# If the LLM judge is unavailable (no key / provider down), fall back to a
# deterministic heuristic judge instead of failing the run.
LLM_JUDGE_FALLBACK_HEURISTIC=true

# --- Regression gate ---
REGRESSION_SCORE_DROP_THRESHOLD=10
REGRESSION_PASS_RATE_DROP_THRESHOLD=0.1

# --- Demo target agent (scripts/demo_target_agent.py) ---
DEMO_AGENT_PORT=9000
# Set to true to make the demo agent intermittently misbehave, which lets
# you watch AVaaS actually catch a regression end-to-end.
DEMO_AGENT_BUG_MODE=false
