# ------------------------------------------------------------------
# AVaaS environment configuration
# Copy this file to .env and fill in the values you need.
# Every variable has a safe default except where noted MANDATORY.
# Nothing here is mandatory to get the full platform running locally.
# ------------------------------------------------------------------

# --- App ---
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Multi-tenancy / auth ---
# When true (default), every /api/* call must send a valid tenant API key
# in the X-API-Key header (see POST /api/tenants to create one). Set to
# false for local single-user experimentation - a "default" tenant is then
# used implicitly and no header is required.
REQUIRE_API_KEY=true

# --- Database (SQLite by default, no setup required) ---
DATABASE_URL=sqlite:///./avaas.db

# --- LLM provider (Pluggable Architecture: Ollama primary / Gemini fallback) ---
# One of: mock | ollama | gemini
# mock    -> no external service required, deterministic heuristic scoring.
#            Use this to run the whole system with zero API keys/services.
# ollama  -> requires a local Ollama server (https://ollama.com) running
#            (OLLAMA_BASE_URL/OLLAMA_MODEL below). This is the primary,
#            data-sovereign engine per the tech-stack requirement.
# gemini  -> commercial fallback. Requires GEMINI_API_KEY below.
#            LLMClient automatically falls back mock->this is NOT automatic
#            provider switching (see docs/architecture.md "Provider
#            fallback"); LLM_PROVIDER picks the primary attempted provider,
#            and any failure of that provider falls back to the mock
#            heuristic so a run always completes.
LLM_PROVIDER=mock

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# MANDATORY only if LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Execution ---
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENCY=8

# --- Evaluation / scoring (3-tier composite) ---
PASS_SCORE_THRESHOLD=70
COMPOSITE_RULE_WEIGHT=0.4
COMPOSITE_SAFETY_WEIGHT=0.3
COMPOSITE_BUSINESS_WEIGHT=0.3
# If an LLM judge tier is unavailable (no key / provider down), fall back to
# a deterministic heuristic judge for that tier instead of failing the run.
LLM_JUDGE_FALLBACK_HEURISTIC=true

# --- DeepEval (optional) ---
# If true AND the `deepeval` package is installed, the safety/hallucination
# tier additionally runs a DeepEval GEval metric and blends it into that
# tier's score. If false, or the package/API key isn't available, this is
# skipped silently and the tier falls back to the built-in LLM judge only.
USE_DEEPEVAL=false

# --- Regression gate ---
REGRESSION_SCORE_DROP_THRESHOLD=10
REGRESSION_PASS_RATE_DROP_THRESHOLD=0.1

# --- Tracing & Metrics (Pluggable: Langfuse+OpenTelemetry primary / OSS,
#     LangSmith commercial fallback, console fallback if none configured) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=avaas
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=avaas

# --- Demo target agent (scripts/demo_target_agent.py) ---
DEMO_AGENT_PORT=9000
# Set to true to make the demo agent intermittently misbehave, which lets
# you watch AVaaS actually catch a regression end-to-end.
DEMO_AGENT_BUG_MODE=false
